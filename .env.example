# ── Orion Central — konfigurasi server (contoh) ────────────────────────────
# SALIN ke .env lalu isi. JANGAN commit .env. Semua nilai di bawah adalah placeholder.

# Server
CENTRAL_HOST=127.0.0.1
CENTRAL_PORT=8787
NODE_ENV=development

# Database
#   sqlite   : lokal/dev, tanpa layanan eksternal
#   postgres : produksi (Railway) — butuh DATABASE_URL
CENTRAL_DB_DRIVER=sqlite
CENTRAL_DB_FILE=orion-central.db
# DATABASE_URL=postgresql://user:password@host:5432/orion?sslmode=require

# Kunci bootstrap (wajib diisi di produksi). Tanpa ini, /v1/auth/bootstrap menolak semua permintaan.
# Panjang minimal 32 karakter. Simpan di secret manager Railway, jangan di repo.
CENTRAL_SETUP_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# Token
CENTRAL_TOKEN_TTL_HOURS=720

# Batas & keamanan
CENTRAL_RATE_LIMIT_PER_MIN=120
CENTRAL_MAX_BODY_BYTES=1048576

# Desktop → Central (dikonfigurasi di app, bukan di server)
# CENTRAL_URL=https://orion-central.up.railway.app

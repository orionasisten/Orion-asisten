# ORION Mobile — environment (contoh)
# SALIN ke mobile/.env lalu isi. JANGAN commit .env (sudah di .gitignore).

# URL Orion Central (tanpa trailing slash) — wajib untuk aplikasi berjalan.
# Development  : http://127.0.0.1:8787  (server lokal)
# Staging      : https://<staging-domain>
# Production   : https://orion-central.up.railway.app
EXPO_PUBLIC_ORION_API_URL=http://127.0.0.1:8787

# EAS project id — HANYA diperlukan untuk push notification NYATA (FCM/APNs).
# Tanpa ini, aplikasi berjalan dalam mode pengembangan: push tidak aktif & dilaporkan jujur ke Owner.
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# CATATAN KEAMANAN:
# - Tidak ada API key model, secret server, atau token perangkat di file ini.
# - Token perangkat diperoleh dari Web App (Perangkat → + Token perangkat) dan disimpan
#   di secure store perangkat, bukan di environment.
